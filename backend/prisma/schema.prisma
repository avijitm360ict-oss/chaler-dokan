datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. SaaS & Multi-tenancy
// -------------------------------------------------------------

model Tenant {
  id               String   @id @default(uuid())
  name             String
  ownerName        String   @map("owner_name")
  phone            String   @unique
  planId           String?  @map("plan_id")
  status           String   @default("trial") // trial, active, suspended
  trialEndsAt      DateTime @map("trial_ends_at")
  settings         Json?    @default("{}")
  languageDefault  String   @default("bn") @map("language_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  plan             Plan?    @relation(fields: [planId], references: [id])
  users            User[]
  roles            Role[]
  products         Product[]
  warehouses       Warehouse[]
  parties          Party[]
  purchases        Purchase[]
  sales            Sale[]
  accounts         Account[]
  payments         Payment[]
  expenses         Expense[]
  auditLogs        AuditLog[]
  dayClosings      DayClosing[]

  @@map("tenants")
}

model Plan {
  id             String   @id @default(uuid())
  name           String
  maxUsers       Int      @default(3) @map("max_users")
  maxWarehouses  Int      @default(1) @map("max_warehouses")
  features       Json?    @default("{}")
  pricePaisa     BigInt   @default(0) @map("price_paisa")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenants        Tenant[]

  @@map("plans")
}

model User {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  name          String
  phone         String
  email         String?
  passwordHash  String    @map("password_hash")
  roleId        String    @map("role_id")
  status        String    @default("active") // active, inactive
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role      @relation(fields: [roleId], references: [id])

  @@unique([tenantId, phone])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   // Super Admin, Owner, Manager, Cashier, Viewer
  permissions Json     // Action matrix: { sales: ["view", "create"], reports: ["view"] }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

model DocSequence {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  docType   String @map("doc_type") // invoice, purchase, sale_return, purchase_return, payment
  year      Int
  lastNo    Int    @default(0) @map("last_no")

  @@unique([tenantId, docType, year])
  @@map("doc_sequences")
}

// -------------------------------------------------------------
// 2. Catalog: Rice Products, Categories & Packaging Units
// -------------------------------------------------------------

model Category {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  nameBn    String    @map("name_bn")
  nameEn    String    @map("name_en")
  parentId  String?   @map("parent_id")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("categories")
}

model Product {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  nameBn      String         @map("name_bn") // e.g. মিনিকেট চাল (প্রিমিয়াম)
  nameEn      String         @map("name_en") // e.g. Miniket Rice (Premium)
  categoryId  String?        @map("category_id")
  variety     String?        // মিনিকেট, নাজিরশাইল, বাসমতি, পাইজাম, বিআর-২৮
  grade       String?        // স্পেশাল, রেগুলার, মোটা
  sku         String?
  minStockKg  Decimal        @default(100.000) @db.Decimal(14, 3) @map("min_stock_kg")
  status      String         @default("active") // active, inactive
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id])
  units       ProductUnit[]
  prices      ProductPrice[]
  movements   StockMovement[]
  balances    StockBalance[]

  @@index([tenantId, status])
  @@map("products")
}

model ProductUnit {
  id                String         @id @default(uuid())
  tenantId          String         @map("tenant_id")
  productId         String         @map("product_id")
  nameBn            String         @map("name_bn") // কেজি, ৫০ কেজি বস্তা, ২৫ কেজি বস্তা, মণ
  nameEn            String         @map("name_en") // kg, 50kg bag, 25kg bag, mon
  kgPerUnit         Decimal        @db.Decimal(14, 3) @map("kg_per_unit") // 1.000 for kg, 50.000 for sack
  isBase            Boolean        @default(false) @map("is_base") // Base unit is KG
  isDefaultSale     Boolean        @default(false) @map("is_default_sale")
  isDefaultPurchase Boolean        @default(false) @map("is_default_purchase")

  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices            ProductPrice[]

  @@map("product_units")
}

model ProductPrice {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  productId     String      @map("product_id")
  unitId        String      @map("unit_id")
  priceType     String      @map("price_type") // retail, wholesale, dealer
  pricePaisa    BigInt      @map("price_paisa") // stored in paisa (100 tk = 10000 paisa)
  effectiveFrom DateTime    @default(now()) @map("effective_from")
  setBy         String?     @map("set_by")

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit          ProductUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, unitId, priceType])
  @@map("product_prices")
}

// -------------------------------------------------------------
// 3. Inventory: Warehouses, Movements & WAC
// -------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String   // e.g. মেইন গোডাউন, আড়ত গোডাউন নং ১
  address   String?
  isDefault Boolean  @default(false) @map("is_default")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances  StockBalance[]
  movements StockMovement[]

  @@map("warehouses")
}

model StockMovement {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  productId    String    @map("product_id")
  warehouseId  String    @map("warehouse_id")
  qtyKg        Decimal   @db.Decimal(14, 3) @map("qty_kg") // + for in, - for out
  unitCostPaisa BigInt   @default(0) @map("unit_cost_paisa") // paisa per kg
  movementType String    @map("movement_type") // opening, purchase, sale, purchase_return, sale_return, transfer_in, transfer_out, adjustment
  refType      String?   @map("ref_type") // purchase, sale, adjustment, transfer
  refId        String?   @map("ref_id")
  reason       String?
  occurredAt   DateTime  @default(now()) @map("occurred_at")

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, warehouseId, occurredAt])
  @@map("stock_movements")
}

model StockBalance {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  productId   String    @map("product_id")
  warehouseId String    @map("warehouse_id")
  qtyKg       Decimal   @default(0.000) @db.Decimal(14, 3) @map("qty_kg")
  avgCostPaisa BigInt   @default(0) @map("avg_cost_paisa") // WAC (Weighted Average Cost per KG in paisa)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, warehouseId])
  @@map("stock_balances")
}

// -------------------------------------------------------------
// 4. Parties: Millers, Mohajons, Wholesalers & Retail Clients
// -------------------------------------------------------------

model Party {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  name            String
  shopName        String?       @map("shop_name")
  phone           String
  address         String?
  isVendor        Boolean       @default(false) @map("is_vendor") // Supplier/Miller/Mohajon
  isClient        Boolean       @default(false) @map("is_client") // Buyer/Customer
  clientType      String?       @map("client_type") // retail, wholesale, dealer
  vendorType      String?       @map("vendor_type") // mill, arot, mohajon
  openingBalance  BigInt        @default(0) @map("opening_balance") // in paisa (+ receivable, - payable)
  creditLimit     BigInt        @default(0) @map("credit_limit") // in paisa
  status          String        @default("active")
  createdAt       DateTime      @default(now()) @map("created_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases       Purchase[]
  sales           Sale[]
  ledgerEntries   PartyLedger[]
  payments        Payment[]

  @@index([tenantId, phone])
  @@map("parties")
}

model PartyLedger {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  partyId        String    @map("party_id")
  entryDate      DateTime  @default(now()) @map("entry_date")
  entryType      String    @map("entry_type") // sale, purchase, sale_return, purchase_return, payment_in, payment_out, opening, adjustment
  refType        String?   @map("ref_type")
  refId          String?   @map("ref_id")
  debitPaisa     BigInt    @default(0) @map("debit_paisa")
  creditPaisa    BigInt    @default(0) @map("credit_paisa")
  runningBalance BigInt    @default(0) @map("running_balance")

  party          Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([tenantId, partyId, entryDate])
  @@map("party_ledger")
}

// -------------------------------------------------------------
// 5. Purchases & Landed Cost
// -------------------------------------------------------------

model Purchase {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  docNo          String            @map("doc_no") // e.g. PUR-2026-00001
  vendorId       String            @map("vendor_id")
  warehouseId    String            @map("warehouse_id")
  purchaseDate   DateTime          @default(now()) @map("purchase_date")
  status         String            @default("draft") // draft, confirmed, voided
  subtotalPaisa  BigInt            @default(0) @map("subtotal_paisa")
  extraCostPaisa BigInt            @default(0) @map("extra_cost_paisa") // truck fare, labour etc.
  grandTotalPaisa BigInt           @default(0) @map("grand_total_paisa")
  paidTotalPaisa BigInt            @default(0) @map("paid_total_paisa")
  vendorBillNo   String?           @map("vendor_bill_no")
  note           String?
  createdAt      DateTime          @default(now()) @map("created_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor         Party             @relation(fields: [vendorId], references: [id])
  items          PurchaseItem[]
  expenses       PurchaseExpense[]

  @@unique([tenantId, docNo])
  @@map("purchases")
}

model PurchaseItem {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  purchaseId             String   @map("purchase_id")
  productId              String   @map("product_id")
  unitId                 String   @map("unit_id")
  qtyUnit                Decimal  @db.Decimal(14, 3) @map("qty_unit")
  qtyKg                  Decimal  @db.Decimal(14, 3) @map("qty_kg")
  unitPricePaisa         BigInt   @map("unit_price_paisa")
  lineTotalPaisa         BigInt   @map("line_total_paisa")
  allocatedExtraPaisa    BigInt   @default(0) @map("allocated_extra_paisa")
  landedUnitCostPerKg    BigInt   @map("landed_unit_cost_per_kg")

  purchase               Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

model PurchaseExpense {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  purchaseId       String   @map("purchase_id")
  expenseType      String   @map("expense_type") // transport, labour, unloading, other
  amountPaisa      BigInt   @map("amount_paisa")
  allocationMethod String   @default("weight") @map("allocation_method") // weight, value

  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_expenses")
}

// -------------------------------------------------------------
// 6. Sales, Quick POS & Profit Snapshots
// -------------------------------------------------------------

model Sale {
  id                 String     @id @default(uuid())
  tenantId           String     @map("tenant_id")
  docNo              String     @map("doc_no") // e.g. INV-2026-00001
  clientId           String?    @map("client_id")
  warehouseId        String     @map("warehouse_id")
  saleDate           DateTime   @default(now()) @map("sale_date")
  channel            String     @default("pos") // pos, invoice
  status             String     @default("confirmed") // confirmed, voided
  subtotalPaisa      BigInt     @default(0) @map("subtotal_paisa")
  discountPaisa      BigInt     @default(0) @map("discount_paisa")
  deliveryChargePaisa BigInt    @default(0) @map("delivery_charge_paisa")
  grandTotalPaisa    BigInt     @default(0) @map("grand_total_paisa")
  paidTotalPaisa     BigInt     @default(0) @map("paid_total_paisa")
  dueAmountPaisa     BigInt     @default(0) @map("due_amount_paisa")
  idempotencyKey     String?    @map("idempotency_key")
  createdAt          DateTime   @default(now()) @map("created_at")

  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client             Party?     @relation(fields: [clientId], references: [id])
  items              SaleItem[]

  @@unique([tenantId, docNo])
  @@index([tenantId, saleDate])
  @@map("sales")
}

model SaleItem {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  saleId               String   @map("sale_id")
  productId            String   @map("product_id")
  unitId               String   @map("unit_id")
  qtyUnit              Decimal  @db.Decimal(14, 3) @map("qty_unit")
  qtyKg                Decimal  @db.Decimal(14, 3) @map("qty_kg")
  unitPricePaisa       BigInt   @map("unit_price_paisa")
  discountPaisa        BigInt   @default(0) @map("discount_paisa")
  lineTotalPaisa       BigInt   @map("line_total_paisa")
  costPerKgSnapshot    BigInt   @map("cost_per_kg_snapshot") // exact WAC cost snapshot at the moment of sale

  sale                 Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

// -------------------------------------------------------------
// 7. Money, Accounts, Payments, Expenses & Cash Close
// -------------------------------------------------------------

model Account {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  name           String    // Cash Drawer (নগদ ক্যাশ), DBBL Bank, bKash Merchant, Nagad
  type           String    // cash, bank, mobile_wallet
  openingBalance BigInt    @default(0) @map("opening_balance")
  currentBalance BigInt    @default(0) @map("current_balance")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments       Payment[]
  expenses       Expense[]

  @@map("accounts")
}

model Payment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  docNo       String   @map("doc_no")
  direction   String   // in (from customer), out (to vendor/expense)
  partyId     String?  @map("party_id")
  accountId   String   @map("account_id")
  amountPaisa BigInt   @map("amount_paisa")
  method      String   // cash, bkash, nagad, bank_transfer, cheque
  referenceNo String?  @map("reference_no")
  paidAt      DateTime @default(now()) @map("paid_at")
  note        String?
  status      String   @default("confirmed") // confirmed, voided

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party       Party?   @relation(fields: [partyId], references: [id])
  account     Account  @relation(fields: [accountId], references: [id])

  @@unique([tenantId, docNo])
  @@map("payments")
}

model ExpenseCategory {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  nameBn    String    @map("name_bn") // দোকান ভাড়া, বিদ্যুৎ বিল, লেবার/মুজুরি, ট্রাক ভাড়া, অন্যান্য
  nameEn    String    @map("name_en")

  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  categoryId    String          @map("category_id")
  accountId     String          @map("account_id")
  amountPaisa   BigInt          @map("amount_paisa")
  spentAt       DateTime        @default(now()) @map("spent_at")
  note          String?
  attachmentUrl String?         @map("attachment_url")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  account       Account         @relation(fields: [accountId], references: [id])

  @@map("expenses")
}

model DayClosing {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  date              DateTime @map("date")
  systemCashPaisa   BigInt   @map("system_cash_paisa")
  countedCashPaisa  BigInt   @map("counted_cash_paisa")
  differencePaisa   BigInt   @map("difference_paisa")
  closedBy          String   @map("closed_by")
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("day_closings")
}
